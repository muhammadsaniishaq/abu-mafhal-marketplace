{
  "expo": {
    "name": "Abu Mafhal",
    "slug": "abu-mafhal",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.abumafhal.app",
      "versionCode": 10,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "baseUrl": "./"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Ionicons.ttf",
            "./assets/fonts/Feather.ttf",
            "./assets/fonts/FontAwesome.ttf",
            "./assets/fonts/FontAwesome5_Brands.ttf",
            "./assets/fonts/FontAwesome5_Regular.ttf",
            "./assets/fonts/FontAwesome5_Solid.ttf",
            "./assets/fonts/MaterialCommunityIcons.ttf",
            "./assets/fonts/MaterialIcons.ttf",
            "./assets/fonts/AntDesign.ttf",
            "./assets/fonts/Entypo.ttf",
            "./assets/fonts/Octicons.ttf",
            "./assets/fonts/SimpleLineIcons.ttf"
          ]
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "d620bd4d-1d1c-4224-8acf-572df6608bda"
      }
    }
  }
}
