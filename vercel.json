{
    "buildCommand": "npm run build && mkdir -p dist/mobile && cp -R mobile/dist/* dist/mobile/ && mkdir -p dist/_expo && cp -R mobile/dist/_expo/* dist/_expo/ && mkdir -p dist/assets && cp -R mobile/dist/assets/* dist/assets/",
    "outputDirectory": "dist",
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Vary",
                    "value": "User-Agent"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/",
            "has": [
                {
                    "type": "header",
                    "key": "User-Agent",
                    "value": ".*(Android|iPhone|iPad|iPod|Opera Mini|IEMobile|Mobile|android|iphone|ipad|ipod|mobile).*"
                }
            ],
            "destination": "/mobile",
            "permanent": false
        },
        {
            "source": "/shop",
            "has": [
                {
                    "type": "header",
                    "key": "User-Agent",
                    "value": ".*(Android|iPhone|iPad|iPod|Opera Mini|IEMobile|Mobile|android|iphone|ipad|ipod|mobile).*"
                }
            ],
            "destination": "/mobile#shop",
            "permanent": false
